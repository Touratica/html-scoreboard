{
  "name": "@touratica/html-scoreboard",
  "version": "0.0.0-development",
  "description": "Self-serving HTML scoreboard.",
  "homepage": "https://github.com/Touratica/html-scoreboard#readme",
  "bugs": {
    "url": "https://github.com/Touratica/html-scoreboard/issues"
  },
  "license": "EUPL-1.2",
  "author": "João Pedro Almeida <me@touratica.pt> (https://github.com/Touratica)",
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "bin": {
    "html-scoreboard": "dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Touratica/html-scoreboard.git"
  },
  "scripts": {
    "build": "pnpm run build:prod",
    "build:dev": "webpack --mode=development",
    "build:prod": "webpack --mode=production --config-node-env=production",
    "watch": "webpack --watch",
    "serve": "webpack serve",
    "semantic-release": "semantic-release",
    "prepack": "pnpm run build",
    "start": "node .",
    "lint": "eslint ./src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/http-server": "^0.12.4",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.2",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "favicons": "^7.3.1",
    "favicons-webpack-plugin": "^6.0.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^7.3.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "semantic-release": "^25.0.9",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-shebang-plugin": "^1.1.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.1 || >=24.10.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "lint-staged": {
    "*.{js,ts}": "eslint",
    "**/*": "prettier --write --ignore-unknown"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
